# Copy this file to .env.local for local development, and add the same
# variables in Vercel → Project Settings → Environment Variables for production.
# Every variable here is optional at launch — the site works with none of them
# set, using sensible fallbacks (see src/lib/site-config.ts and src/lib/forms/*).

# --- Site -------------------------------------------------------------
# The canonical URL once the GoDaddy domain is connected (used in metadata,
# sitemap, structured data). Falls back to a placeholder if unset.
NEXT_PUBLIC_SITE_URL=https://www.standupsis.org

# Contact email shown on the site and used as the mailto: link.
NEXT_PUBLIC_CONTACT_EMAIL=hello@standupsis.org

# --- Analytics (Plausible — cookieless, no consent banner needed) -----
# Leave unset to disable analytics entirely.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=standupsis.org

# --- Form email notifications (Resend) ---------------------------------
# Without these, form submissions are still accepted and logged server-side,
# just not emailed. Get an API key at https://resend.com.
RESEND_API_KEY=
FORM_NOTIFY_EMAIL=
FORM_FROM_EMAIL="Stand Up Sis Website <onboarding@resend.dev>"

# --- Form submission storage (Supabase) --------------------------------
# Without these, submissions are logged to the server console only (visible
# in Vercel's function logs) rather than persisted to a database.
# Create a `form_submissions` table (jsonb columns match the fields each
# form posts) in a free Supabase project, then set these.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Spam protection (Cloudflare Turnstile) ----------------------------
# Optional. Forms already ship with a honeypot field, which stops most bots.
# Add Turnstile if spam becomes a problem: create a site at
# https://dash.cloudflare.com/?to=/:account/turnstile, add the widget to the
# relevant form component client-side, and set the secret here for
# src/lib/forms/spam.ts to verify it server-side.
TURNSTILE_SECRET_KEY=
